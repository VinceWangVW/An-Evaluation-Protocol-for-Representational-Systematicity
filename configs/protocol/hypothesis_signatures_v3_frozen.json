{
  "version": "v2_generation_strongest_control_phase9_frozen",
  "audit_preconditions": [
    {
      "signal": "behavior_anchor_ready",
      "op": "==",
      "value": true,
      "description": "The audited model must provide its own balanced behavior anchor."
    },
    {
      "signal": "m0_matched_set_count",
      "op": ">=",
      "value": 6,
      "description": "The protocol requires at least six matched case-level pass/fail sets."
    },
    {
      "signal": "b0_control_clause_f1",
      "op": ">=",
      "value": 0.5,
      "description": "Control items must be solved above a non-trivial clause-F1 floor."
    },
    {
      "signal": "m1_surface_control_gap_observed",
      "op": "==",
      "value": true,
      "description": "Surface-control signals must be measurable in the current run."
    },
    {
      "signal": "m1_predicate_gap_observed",
      "op": "==",
      "value": true,
      "description": "Predicate identity signals must be measurable in the current run."
    }
  ],
  "signal_definitions": {
    "behavior_anchor_ready": {
      "module": "M0",
      "description": "Audited-model behavior strata exist and are balanced."
    },
    "b0_control_clause_f1": {
      "module": "B0",
      "description": "Average control split clause F1."
    },
    "b0_control_minus_gen_clause_gap": {
      "module": "B0",
      "description": "Control minus generalization clause-F1 gap."
    },
    "b0_gen_clause_f1": {
      "module": "B0",
      "description": "Generalization split clause F1."
    },
    "m0_matched_set_count": {
      "module": "M0",
      "description": "Number of matched behavior-anchored audit sets."
    },
    "m1_filler_gap": {
      "module": "M1",
      "description": "Within-minus-between cosine gap for filler identity."
    },
    "m1_predicate_gap": {
      "module": "M1",
      "description": "Within-minus-between cosine gap for predicate identity."
    },
    "m1_predicate_gap_observed": {
      "module": "M1",
      "description": "Predicate-identity signal is measurable."
    },
    "m1_semantic_role_accuracy": {
      "module": "M1",
      "description": "Leave-one-out centroid accuracy for semantic roles."
    },
    "m1_surface_control_gap": {
      "module": "M1",
      "description": "Semantic-role accuracy minus surface-position accuracy."
    },
    "m1_surface_control_gap_observed": {
      "module": "M1",
      "description": "Surface-control signal is measurable."
    },
    "m2_actual_vs_non_role_advantage_mean": {
      "module": "M2",
      "description": "Actual minus non-role counterfactual clause-F1 advantage."
    },
    "m2_actual_vs_strongest_control_advantage_mean": {
      "module": "M2",
      "description": "Actual minus strongest-control counterfactual clause-F1 advantage."
    },
    "m2_actual_vs_strongest_control_permutation_p_value": {
      "module": "M2",
      "description": "Permutation p-value for actual versus strongest-control M2 effect."
    },
    "m2_actual_vs_wrong_role_advantage_mean": {
      "module": "M2",
      "description": "Actual minus wrong-role counterfactual clause-F1 advantage."
    },
    "m3_role_vs_non_role_gap_clause_f1": {
      "module": "M3",
      "description": "Role-ablation minus non-role clause-F1 drop."
    },
    "m3_role_vs_strongest_control_gap_clause_f1": {
      "module": "M3",
      "description": "Role-ablation minus strongest-control clause-F1 drop."
    },
    "m3_role_vs_strongest_control_permutation_p_value": {
      "module": "M3",
      "description": "Permutation p-value for role-ablation versus strongest-control gap."
    },
    "m3_role_vs_wrong_role_gap_clause_f1": {
      "module": "M3",
      "description": "Role-ablation minus wrong-role clause-F1 drop."
    },
    "m4_actual_vs_non_role_advantage_mean": {
      "module": "M4",
      "description": "Actual minus non-role rescue clause-F1 advantage."
    },
    "m4_actual_vs_strongest_control_advantage_mean": {
      "module": "M4",
      "description": "Actual minus strongest-control rescue clause-F1 advantage."
    },
    "m4_actual_vs_strongest_control_permutation_p_value": {
      "module": "M4",
      "description": "Permutation p-value for actual versus strongest-control rescue effect."
    },
    "m4_actual_vs_wrong_role_advantage_mean": {
      "module": "M4",
      "description": "Actual minus wrong-role rescue clause-F1 advantage."
    },
    "m5_fail_item_rescue_advantage_coverage": {
      "module": "M5",
      "description": "Fail-item coverage with positive rescue-over-control advantage."
    }
  },
  "hypotheses": [
    {
      "id": "G1_binding",
      "label": "Binding Hypothesis",
      "description": "Role-filler bindings are present and can be causally recruited for generation behavior.",
      "states": [
        {
          "id": "H2",
          "meaning": "Binding-like structure is present and causally used for behavior.",
          "support": {
            "all": [
              {
                "signal": "behavior_anchor_ready",
                "op": "==",
                "value": true
              },
              {
                "signal": "b0_gen_clause_f1",
                "op": ">=",
                "value": 0.25
              },
              {
