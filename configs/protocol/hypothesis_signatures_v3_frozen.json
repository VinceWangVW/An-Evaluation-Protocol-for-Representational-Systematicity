            "any": [
              {
                "signal": "m2_actual_vs_strongest_control_advantage_mean",
                "op": ">=",
                "value": 0.02
              },
              {
                "signal": "m3_role_vs_strongest_control_gap_clause_f1",
                "op": ">=",
                "value": 0.02
              },
              {
                "signal": "m4_actual_vs_strongest_control_advantage_mean",
                "op": ">=",
                "value": 0.01
              }
            ]
          }
        },
        {
          "id": "H0",
          "meaning": "No reliable evidence for behavior-relevant binding-like structure.",
          "default": true
        }
      ]
    },
