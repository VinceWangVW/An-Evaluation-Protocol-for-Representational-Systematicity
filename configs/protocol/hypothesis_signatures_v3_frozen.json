                "op": "<=",
                "value": 0.1
              },
              {
                "signal": "m3_role_vs_strongest_control_gap_clause_f1",
                "op": ">=",
                "value": 0.05
              },
              {
                "signal": "m3_role_vs_strongest_control_permutation_p_value",
                "op": "<=",
                "value": 0.1
              },
              {
                "signal": "m4_actual_vs_strongest_control_advantage_mean",
                "op": ">=",
                "value": 0.03
              },
              {
                "signal": "m4_actual_vs_strongest_control_permutation_p_value",
                "op": "<=",
                "value": 0.1
              }
            ]
          },
          "falsifiers": {
            "any": [
              {
                "signal": "m2_actual_vs_strongest_control_advantage_mean",
                "op": "<=",
                "value": 0.02
              },
              {
                "signal": "m3_role_vs_strongest_control_gap_clause_f1",
                "op": "<=",
                "value": 0.02
              },
              {
                "signal": "m4_actual_vs_strongest_control_advantage_mean",
                "op": "<=",
                "value": 0.01
              }
            ]
          }
        },
        {
          "id": "H1",
          "meaning": "Binding-like structure is present, but generation-level causal use remains incomplete.",
          "support": {
            "all": [
              {
                "signal": "behavior_anchor_ready",
                "op": "==",
                "value": true
              },
              {
                "signal": "m1_semantic_role_accuracy",
                "op": ">=",
                "value": 0.55
              }
